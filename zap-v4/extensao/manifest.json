{
  "manifest_version": 3,
  "name": "ZAP Imóveis v4 - coleta com maestro",
  "version": "4.1.0",
  "description": "Coleta simplificada nacional, com uma tarefa por município e tipo distribuída pelo servidor.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.zapimoveis.com.br/*",
    "https://zapimoveis.com.br/*",
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_scripts": [{
    "matches": ["https://www.zapimoveis.com.br/*", "https://zapimoveis.com.br/*"],
    "js": ["worker_config.js", "classificadores.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
